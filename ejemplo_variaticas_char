#include <stdarg.h>
#include <unistd.h>

/* Versión que devuelve el número de caracteres impresos (como printf real) */
int miniprintf_contador(const char *format, ...) {
    va_list args;
    int contador = 0;
    
    va_start(args, format);
    
    while (*format != '\0') {
        if (*format == '%') {
            format++;
            
            if (*format == 'c') {
                char c = (char)va_arg(args, int);
                write(1, &c, 1);
                contador++;
            } else if (*format == '%') {
                write(1, "%", 1);
                contador++;
            } else {
                // No reconocido - imprimir % y el carácter
                write(1, "%", 1);
                write(1, format, 1);
                contador += 2;
            }
        } else {
            write(1, format, 1);
            contador++;
        }
        
        format++;
    }
    
    va_end(args);
    return contador;
}

