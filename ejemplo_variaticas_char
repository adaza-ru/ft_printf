/* Función auxiliar para escribir un carácter */
void mi_putchar(char c) {
    write(1, &c, 1);
}

/* 
 * miniprintf ultrasimple - solo maneja:
 * - Texto normal
 * - %c para caracteres
 * - %% para el símbolo %
 */
void miniprintf(const char *format, ...) {
    va_list args;          // Declarar lista de argumentos variables
    
    // Inicializar args para acceder a los argumentos después de 'format'
    va_start(args, format);
    
    // Recorrer la cadena de formato carácter por carácter
    while (*format != '\0') {
        if (*format == '%') {
            // Verificar el siguiente carácter
            format++;  // Avanzar al siguiente carácter
            
            switch (*format) {
                case 'c': {  // %c - imprimir un carácter
                    // IMPORTANTE: char se promociona a int en argumentos variables
                    char c = (char)va_arg(args, int);
                    mi_putchar(c);
                    break;
                }
                case '%': {  // %% - imprimir el símbolo %
                    mi_putchar('%');
                    break;
                }
                default: {   // Si hay % seguido de algo no reconocido
                    mi_putchar('%');
                    mi_putchar(*format);
                    break;
                }
            }
        } else {
            // Carácter normal - imprimirlo directamente
            mi_putchar(*format);
        }
        
        format++;  // Avanzar al siguiente carácter del formato
    }
    
    // Limpiar la lista de argumentos variables
    va_end(args);
}

